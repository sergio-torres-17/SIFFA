# Copia este archivo como .env (no se sube a git).
# Contraseña de sa: mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
MSSQL_SA_PASSWORD=Cambia_Esta_Clave_123
DB_PORT=1433
WEB_PORT=8080

# Clave de activación: se pide al activar el sistema y crear la contraseña del administrador.
SIFFA_ACTIVATION_KEY=Cambia_Esta_Clave_De_Activacion

# Clave de API para consultar /api/attendance con la cabecera X-Api-Key (opcional).
SIFFA_API_KEY=
