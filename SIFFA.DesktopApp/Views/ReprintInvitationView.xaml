<Window x:Class="SIFFA.DesktopApp.Views.ReprintInvitationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIFFA · Reimprimir invitación" Width="640" Height="760" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource SiffaWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,28">
            <TextBlock Style="{StaticResource Heading}" Text="Reimprimir invitación" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                       Text="Escribe el nombre, el número de empleado o el correo, presiona Enter y se imprime su invitación en la impresora térmica." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="NOMBRE, NÚMERO DE EMPLEADO O CORREO" />
            <TextBox x:Name="TxtTerm" KeyDown="OnKeyDown" TextChanged="OnTextChanged" />

            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Margin="2,12,0,0" Visibility="Collapsed" />

            <!-- Varias coincidencias -->
            <StackPanel x:Name="MatchesPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="VARIAS COINCIDENCIAS, ELIGE AL EMPLEADO" Margin="2,0,0,6" />
                <ItemsControl x:Name="Matches">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="OnPick" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource BrushLavender}" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Invitación encontrada -->
            <Border x:Name="PreviewPanel" Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtWho" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <Border Background="White" CornerRadius="8" Padding="10">
                        <Image x:Name="PreviewImage" MaxHeight="320" Stretch="Uniform" />
                    </Border>
                    <Button x:Name="BtnPrint" Style="{StaticResource PrimaryButton}" Content="Imprimir invitación" Margin="0,14,0,0" Click="OnPrint" />
                </StackPanel>
            </Border>

            <!-- Preferencias (se recuerdan en este equipo) -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="CÓDIGO DE LA INVITACIÓN" Margin="2,20,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbBarcode" GroupName="Code" Style="{StaticResource CardRadio}" Margin="0,0,8,0" Checked="OnOptionChanged">
                    <TextBlock Text="Código de barras" FontWeight="SemiBold" />
                </RadioButton>
                <RadioButton x:Name="RbQr" GroupName="Code" Style="{StaticResource CardRadio}" Margin="0" Checked="OnOptionChanged">
                    <TextBlock Text="Código QR" FontWeight="SemiBold" />
                </RadioButton>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="ORIENTACIÓN DEL PAPEL" Margin="2,8,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbHorizontal" GroupName="Orientation" Style="{StaticResource CardRadio}" Margin="0,0,8,0" Checked="OnOptionChanged">
                    <TextBlock Text="Horizontal" FontWeight="SemiBold" />
                </RadioButton>
                <RadioButton x:Name="RbVertical" GroupName="Orientation" Style="{StaticResource CardRadio}" Margin="0" Checked="OnOptionChanged">
                    <TextBlock Text="Vertical (gira la invitación)" FontWeight="SemiBold" />
                </RadioButton>
            </StackPanel>

            <!-- Logo: se elige una sola vez -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="LOGO DE LA EMPRESA" Margin="2,8,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" x:Name="BtnLogo" Content="Elegir logo" Padding="14,8" Click="OnPickLogo" />
                <TextBlock x:Name="TxtLogo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="2,0,12,0" />
            </DockPanel>

            <Button Style="{StaticResource GhostButton}" Content="Cerrar" HorizontalAlignment="Left" Margin="0,22,0,0" Click="OnClose" />
        </StackPanel>
    </ScrollViewer>
</Window>
