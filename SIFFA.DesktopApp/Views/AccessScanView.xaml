<Window x:Class="SIFFA.DesktopApp.Views.AccessScanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIFFA · Acceso" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource SiffaWindow}">
    <StackPanel Margin="40,28,40,26">
        <TextBlock x:Name="TxtTitle" Style="{StaticResource Heading}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,10"
                   Text="Escanea el código de barras o escribe el número, nombre o correo institucional y presiona Enter." />

        <TextBlock Style="{StaticResource FieldLabel}" Text="CÓDIGO, NOMBRE O CORREO" />
        <TextBox x:Name="TxtTerm" KeyDown="OnKeyDown" TextChanged="OnTextChanged" />

        <ProgressBar x:Name="Busy" IsIndeterminate="False" Margin="0,10,0,0" Visibility="Collapsed" Value="100" />
        <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Margin="2,12,0,0" Visibility="Collapsed" />

        <StackPanel x:Name="MatchesPanel" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="VARIAS COINCIDENCIAS, ELIGE AL EMPLEADO" Margin="2,0,0,6" />
            <ItemsControl x:Name="Matches">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="OnPick" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource BrushLavender}" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Button Style="{StaticResource GhostButton}" Content="Cerrar" HorizontalAlignment="Right" Margin="0,22,0,0" Click="OnClose" />
    </StackPanel>
</Window>
