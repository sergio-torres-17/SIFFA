<UserControl x:Class="SIFFA.DesktopApp.Views.Pages.AddsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Nuevo adicional" Click="OnCreate" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="Elementos adicionales" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,16,0"
                           Text="Tipos de boleto o entrega que pueden recibir los empleados (agua, comida, bebida, premios…)." />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="Editar" Padding="14,7" Margin="0,0,8,0"
                                                Tag="{Binding}" Click="OnEdit" />
                                        <Button Style="{StaticResource GhostButton}" Content="Eliminar" Padding="14,7"
                                                IsEnabled="{Binding CanDelete}" ToolTip="{Binding DeleteTip}" Tag="{Binding}" Click="OnDelete" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                        <TextBlock Text="{Binding Item.Description}" Foreground="{StaticResource BrushLavender}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Usage}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource BrushCyan}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="TxtEmpty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" Text="No hay adicionales. Crea el primero con &quot;Nuevo adicional&quot;." />
        </Grid>

        <StackPanel Grid.Row="2" Margin="2,10,0,0">
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                       Text="Un adicional en uso (con boletos o configuraciones) no se puede eliminar, para no perder el historial de entregas." />
        </StackPanel>
    </Grid>
</UserControl>
