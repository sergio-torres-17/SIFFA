<UserControl x:Class="SIFFA.DesktopApp.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Actualizar"
                        VerticalAlignment="Center" Click="OnRefresh" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Control de ingresos" />
                    <TextBlock x:Name="TxtUpdated" Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Fiesta de fin de año · cargando…" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxtError" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
            <TextBlock x:Name="TxtNoActions" Style="{StaticResource Muted}" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,12" Visibility="Collapsed"
                       Text="Aún no hay acciones de entrada/salida en el catálogo AccessAction (por ejemplo Entrada y Salida), por eso los accesos aparecen en cero." />

            <!-- Indicadores -->
            <UniformGrid Columns="5" Margin="0,0,0,12">
                <Border Style="{StaticResource Panel}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Registrados" /><TextBlock x:Name="KTotal" Style="{StaticResource KpiValue}" Text="–" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="4,0,4,0">
                    <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Han ingresado" /><TextBlock x:Name="KEntered" Style="{StaticResource KpiValue}" Foreground="{StaticResource BrushCyan}" Text="–" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="4,0,4,0">
                    <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Faltan por ingresar" /><TextBlock x:Name="KPending" Style="{StaticResource KpiValue}" Foreground="#FCD34D" Text="–" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="4,0,4,0">
                    <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Dentro ahora" /><TextBlock x:Name="KInside" Style="{StaticResource KpiValue}" Foreground="{StaticResource BrushSuccess}" Text="–" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="8,0,0,0">
                    <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Ya egresaron" /><TextBlock x:Name="KExited" Style="{StaticResource KpiValue}" Foreground="{StaticResource BrushLavender}" Text="–" /></StackPanel>
                </Border>
            </UniformGrid>

            <!-- Asistencia -->
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="TxtPercent" DockPanel.Dock="Right" Foreground="White" />
                        <TextBlock x:Name="TxtAttendance" Style="{StaticResource Muted}" />
                    </DockPanel>
                    <ProgressBar x:Name="BarAttendance" Minimum="0" Maximum="100" />
                </StackPanel>
            </Border>

            <!-- Gráficas -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Estado de los empleados" />
                        <ItemsControl x:Name="StatusBars">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="White" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent}" Maximum="100" Foreground="{Binding Brush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ingresos por hora" />
                        <TextBlock x:Name="TxtNoHours" Style="{StaticResource Muted}" Text="Todavía no hay ingresos registrados." />
                        <ItemsControl x:Name="HourChart" Height="190">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Entries}" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <Border Height="{Binding BarHeight}" Background="{StaticResource BrushCyan}" CornerRadius="4,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tablas -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Por área" />
                        <DataGrid x:Name="AreaGrid" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="*" />
                                <DataGridTextColumn Header="Registrados" Binding="{Binding Registered}" />
                                <DataGridTextColumn Header="Ingresaron" Binding="{Binding Entered}" />
                                <DataGridTextColumn Header="Faltan" Binding="{Binding Pending}" />
                                <DataGridTextColumn Header="Egresaron" Binding="{Binding Exited}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Últimos accesos" />
                        <TextBlock x:Name="TxtNoAccesses" Style="{StaticResource Muted}" Text="Todavía no hay accesos registrados." Visibility="Collapsed" />
                        <DataGrid x:Name="LatestGrid" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hora" Binding="{Binding Date, StringFormat=dd/MM HH:mm:ss}" />
                                <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeName}" Width="*" />
                                <DataGridTextColumn Header="Área" Binding="{Binding Area}" />
                                <DataGridTextColumn Header="Acción" Binding="{Binding Action}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
