<UserControl x:Class="SIFFA.DesktopApp.Views.Pages.AttendancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnExport" Style="{StaticResource GhostButton}" Content="Exportar a Excel" Margin="0,0,8,0" Click="OnExport" />
                <Button x:Name="BtnRefresh" Style="{StaticResource GhostButton}" Content="Actualizar" Click="OnRefresh" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="Reporte de asistencia" />
                <TextBlock x:Name="TxtUpdated" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Quién está dentro, quién no ha entrado y quién ya salió." />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="TxtError" Grid.Row="1" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

        <!-- Filtros con su conteo -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RbAll" GroupName="Filter" Style="{StaticResource CardRadio}" Margin="0,0,8,0" IsChecked="True" Checked="OnFilter">
                <TextBlock x:Name="LblAll" Text="Todos" FontWeight="SemiBold" />
            </RadioButton>
            <RadioButton x:Name="RbInside" GroupName="Filter" Style="{StaticResource CardRadio}" Margin="0,0,8,0" Checked="OnFilter">
                <TextBlock x:Name="LblInside" Text="Dentro" FontWeight="SemiBold" />
            </RadioButton>
            <RadioButton x:Name="RbPending" GroupName="Filter" Style="{StaticResource CardRadio}" Margin="0,0,8,0" Checked="OnFilter">
                <TextBlock x:Name="LblPending" Text="No han entrado" FontWeight="SemiBold" />
            </RadioButton>
            <RadioButton x:Name="RbExited" GroupName="Filter" Style="{StaticResource CardRadio}" Margin="0" Checked="OnFilter">
                <TextBlock x:Name="LblExited" Text="Ya salieron" FontWeight="SemiBold" />
            </RadioButton>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Panel}">
            <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding EmployeeNumber}" />
                    <DataGridTextColumn Header="Empleado" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Área" Binding="{Binding Area}" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding EmployeeType}" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" />
                    <DataGridTextColumn Header="Primera entrada" Binding="{Binding FirstEntry, StringFormat=dd/MM HH:mm}" />
                    <DataGridTextColumn Header="Último movimiento" Binding="{Binding LastMovement, StringFormat=dd/MM HH:mm}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
