<UserControl x:Class="SIFFA.DesktopApp.Views.Pages.UsersPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Nuevo usuario" Click="OnCreate" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="Usuarios de acceso" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,16,0"
                           Text="Personas que pueden iniciar sesión en SIFFA. El correo es su usuario." />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushNavy}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1.5"
                                    CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="Contraseña" Padding="14,7" Margin="0,0,8,0"
                                                Tag="{Binding}" Click="OnResetPassword" />
                                        <Button Style="{StaticResource GhostButton}" Content="Eliminar" Padding="14,7"
                                                IsEnabled="{Binding CanDelete}" Tag="{Binding}" Click="OnDelete" />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Item.FullName}" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                            <TextBlock Text="  ·  Administrador" Foreground="{StaticResource BrushCyan}" FontSize="12" VerticalAlignment="Center"
                                                       Visibility="{Binding AdminVisibility}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Item.Email}" Foreground="{StaticResource BrushLavender}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0" Foreground="{Binding StatusBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="TxtEmpty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" Text="No hay usuarios. Crea el primero con &quot;Nuevo usuario&quot;." />
        </Grid>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</UserControl>
