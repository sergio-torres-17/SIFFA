<UserControl x:Class="SIFFA.DesktopApp.Views.Pages.AccessPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource Heading}" Text="Control de accesos" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Registra el ingreso o el egreso de los empleados escaneando su código, o buscándolos por nombre o correo." />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,18">
            <Button x:Name="BtnEntry" Style="{StaticResource PrimaryButton}" Content="Registrar ingreso" FontSize="18" Height="92" Margin="0,0,8,0" Click="OnEntry" />
            <Button x:Name="BtnExit" Style="{StaticResource GhostButton}" Content="Registrar egreso" FontSize="18" Height="92" Margin="8,0,0,0" Click="OnExit" />
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Registros de esta sesión" />
                <TextBlock x:Name="TxtEmpty" DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="Todavía no se ha registrado ningún acceso." />
                <DataGrid x:Name="Grid" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Time, StringFormat=HH:mm:ss}" />
                        <DataGridTextColumn Header="Empleado" Binding="{Binding Display}" Width="*" />
                        <DataGridTextColumn Header="Movimiento" Binding="{Binding Movement}" />
                        <DataGridTextColumn Header="Boletos entregados" Binding="{Binding Delivered}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
