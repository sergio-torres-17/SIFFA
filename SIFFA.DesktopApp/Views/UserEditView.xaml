<Window x:Class="SIFFA.DesktopApp.Views.UserEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIFFA · Usuario" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource SiffaWindow}">
    <StackPanel Margin="40,28,40,26">
        <TextBlock x:Name="TxtTitle" Style="{StaticResource Heading}" />
        <TextBlock x:Name="TxtSubtitle" Style="{StaticResource Muted}" Margin="0,4,0,8" />

        <StackPanel x:Name="DataPanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="NOMBRE" />
            <TextBox x:Name="TxtFirst" TextChanged="OnChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="APELLIDOS" />
            <TextBox x:Name="TxtLast" TextChanged="OnChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="CORREO ELECTRÓNICO (SERÁ SU USUARIO)" />
            <TextBox x:Name="TxtEmail" TextChanged="OnChanged" />
        </StackPanel>

        <TextBlock x:Name="LblPassword" Style="{StaticResource FieldLabel}" Text="CONTRASEÑA" />
        <PasswordBox x:Name="TxtPassword" PasswordChanged="OnChanged" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIRMAR CONTRASEÑA" />
        <PasswordBox x:Name="TxtConfirm" PasswordChanged="OnChanged" />

        <TextBlock x:Name="TxtStatus" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" Margin="2,14,0,0" Visibility="Collapsed" />

        <Grid Margin="0,22,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancelar" HorizontalAlignment="Left" Click="OnCancel" />
            <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Content="Guardar" HorizontalAlignment="Right"
                    IsDefault="True" Click="OnSave" />
        </Grid>
    </StackPanel>
</Window>
