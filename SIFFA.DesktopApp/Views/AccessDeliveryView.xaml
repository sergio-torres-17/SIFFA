<Window x:Class="SIFFA.DesktopApp.Views.AccessDeliveryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIFFA · Entrega de boletos" Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource SiffaWindow}">
    <StackPanel Margin="40,28,40,26">
        <TextBlock x:Name="TxtName" Style="{StaticResource Heading}" TextWrapping="Wrap" />
        <TextBlock x:Name="TxtNumber" Style="{StaticResource Muted}" Margin="0,2,0,10" />
        <TextBlock x:Name="TxtMessage" Foreground="{StaticResource BrushSuccess}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock x:Name="TxtEmpty" Style="{StaticResource Muted}" Text="Este empleado no tiene boletos por entregar." Visibility="Collapsed" />

        <StackPanel x:Name="RowsPanel">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Boletos por entregar" Margin="0,0,0,2" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" Text="Marca los que se entregaron y presiona &quot;Guardar entregas&quot;." />
            <Border Style="{StaticResource Panel}" Padding="8,4">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=× {0}}" Foreground="{StaticResource BrushLavender}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Grid.Column="2" Margin="0" Content="Entregado" IsChecked="{Binding Delivered}" IsEnabled="{Binding CanEdit}"
                                          VerticalAlignment="Center" Checked="OnToggle" Unchecked="OnToggle" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <TextBlock x:Name="TxtError" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" Margin="2,12,0,0" Visibility="Collapsed" />

        <Grid Margin="0,22,0,0">
            <Button x:Name="BtnSkip" Style="{StaticResource GhostButton}" Content="Omitir" HorizontalAlignment="Left" Click="OnSkip" />
            <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Content="Guardar entregas" HorizontalAlignment="Right"
                    IsDefault="True" Click="OnSave" />
        </Grid>
    </StackPanel>
</Window>
