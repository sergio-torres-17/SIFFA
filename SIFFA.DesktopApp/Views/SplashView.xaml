<Window x:Class="SIFFA.DesktopApp.Views.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIFFA" Width="640" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Entrada suave -->
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="Logo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.9" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Logo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.9" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Barra de carga sin fin -->
                    <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-100" To="320" Duration="0:0:1.4" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Brillo del punto cian -->
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Card" CornerRadius="26" Margin="12" BorderBrush="{StaticResource BrushLine}" BorderThickness="1.5" Opacity="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource ColorNight}" Offset="0" />
                <GradientStop Color="{StaticResource ColorNavy}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel x:Name="Logo" Orientation="Horizontal" HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9" /></StackPanel.RenderTransform>
                    <TextBlock Text="SIFFA" FontSize="68" FontWeight="Bold" Foreground="White" />
                    <Ellipse x:Name="Glow" Width="16" Height="16" Margin="6,34,0,0" Fill="{StaticResource BrushCyan}" VerticalAlignment="Center">
                        <Ellipse.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="18" ShadowDepth="0" Opacity="1" /></Ellipse.Effect>
                    </Ellipse>
                </StackPanel>
                <TextBlock Text="Control de ingresos · Fiesta de fin de año" HorizontalAlignment="Center" Margin="0,6,0,0"
                           FontSize="15" Foreground="{StaticResource BrushLavender}" />
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Border Width="320" Height="4" CornerRadius="2" Background="{StaticResource BrushLine}" ClipToBounds="True">
                    <Border x:Name="Runner" Width="100" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource BrushCyan}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><TranslateTransform X="-100" /></Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="StatusText" Text="Iniciando…" HorizontalAlignment="Center" Margin="0,14,0,0"
                           FontSize="13" Foreground="{StaticResource BrushLavender}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
