<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Punto de entrada propio (Program.cs) para que Velopack se ejecute antes que WPF. -->
    <StartupObject>SIFFA.DesktopApp.Program</StartupObject>
    <!-- Versión de la app; vpk pack recibe la misma con -v al empaquetar. -->
    <Version>1.0.0</Version>
    <AssemblyName>SIFFA.DesktopApp</AssemblyName>
    <!-- Icono del .exe, del acceso directo y de la barra de tareas. -->
    <ApplicationIcon>Assets/SIFFA.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIFFA.Core\SIFFA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.local.json" Condition="Exists('appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ViewModels\" />
    <Resource Include="Assets/SIFFA.ico" />
    <Resource Include="Assets/logo.png" />
    <!-- Scripts de la base de datos (los mismos de SIFFA.Database) para el botón "Montar base de datos". -->
    <EmbeddedResource Include="..\SIFFA.Database\**\*.sql"
                      Exclude="..\SIFFA.Database\bin\**;..\SIFFA.Database\obj\**;..\SIFFA.Database\Security\Scripts\**"
                      LogicalName="Db/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
