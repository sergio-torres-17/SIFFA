# SIFFA (PHP) · configuración
# Copia este archivo como ".env" (en la misma carpeta que index.php) y llena tus datos.
# Nunca subas el .env real a un repositorio.

APP_NAME=SIFFA
# production | local   (en local se muestran los errores en pantalla)
APP_ENV=production
# Zona horaria con la que se guardan y muestran las horas de acceso
APP_TIMEZONE=America/Mexico_City
# Año que aparece en las tarjetas de invitación (vacío = el año actual)
EVENT_YEAR=

# Base de datos MySQL / MariaDB (los datos los da tu panel de hosting)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Usuario administrador que se crea en la instalación (/setup)
ADMIN_EMAIL=adminsiffa@multicodedev.com
ADMIN_NAME=Administrador SIFFA
# Las tablas y este usuario se crean solos la primera vez que se abre el sitio.
# La contraseña se define desde el navegador, en /setup.
# Clave de activación: se pide en /setup para crear las tablas y dar contraseña al administrador.
# Escribe una larga y privada (equivale al Seed:AdminPassword de la versión .NET).
ADMIN_ACTIVATION_KEY=

# Horas que dura la sesión
SESSION_LIFETIME_HOURS=8
# Intentos de login fallidos permitidos (por IP o por correo) en 15 minutos
LOGIN_MAX_ATTEMPTS=8
