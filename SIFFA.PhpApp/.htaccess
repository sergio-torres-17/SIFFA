# SIFFA · reescritura de rutas y protección de carpetas internas (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nunca se sirven archivos internos ni el .env
    RewriteRule ^(app|vendor|storage|database|resources|views)(/|$) - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^(composer\.(json|lock)|README\.md|\.env\.example)$ - [F,L]

    # Archivos estáticos existentes (assets/…) se sirven tal cual; lo demás va al controlador
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

# Si el servidor no soporta mod_rewrite, también se bloquean los dotfiles
<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>

# Que el Authorization llegue a PHP en hostings con FastCGI
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Subidas de Excel/logo (solo con mod_php; en FPM/CGI se usa .user.ini)
<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>
